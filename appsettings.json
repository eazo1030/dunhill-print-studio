{
  "Cloud": {
    "BaseUrl": "https://dunhill-inventory-service.vercel.app",
    "AuthToken": "",
    "PollIntervalSeconds": 5,
    "Enabled": false
  },
  "Printer": {
    "Connection": "usb",
    "UsbVendorId": "0x0FE6",
    "UsbProductId": "auto",
    "NetworkHost": null,
    "NetworkPort": 9100,
    "CommandLanguage": "PPLZ",
    "LabelWidthDots": 812,
    "LabelHeightDots": 1218,
    "Darkness": 8,
    "PrintSpeed": 4
  },
  "App": {
    "DataFolder": "%LOCALAPPDATA%\\DunhillPrintStudio",
    "Autostart": true,
    "MinimizeToTray": true,
    "StartMinimized": false
  },
  "Sync": {
    "InventoryPushIntervalSeconds": 30,
    "MaxRetries": 5,
    "RetryBackoffSeconds": 10
  }
}
