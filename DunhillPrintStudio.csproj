<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <RootNamespace>Dunhill.PrintStudio</RootNamespace>
    <AssemblyName>DunhillPrintStudio</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>

    <!--
      Disable the auto-generated WPF Main. We provide our own Program.Main that
      runs VelopackApp.Build().Run() FIRST (before any WPF startup) so install /
      uninstall / update hooks can short-circuit the process with the right exit
      code. This is the documented Velopack integration pattern; without it,
      hooks fire AFTER WPF starts and cause mysterious double-launch bugs.
    -->
    <EnableDefaultApplicationDefinition>false</EnableDefaultApplicationDefinition>
    <StartupObject>Dunhill.PrintStudio.Program</StartupObject>

    <!-- Single-file publish settings -->
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>embedded</DebugType>
    <Version>1.0.0</Version>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <Product>Dunhill Print Studio</Product>
    <Company>Dunhill Global</Company>
    <Copyright>Copyright © 2026 Dunhill Global</Copyright>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="8.0.0" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="8.0.0" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="8.0.0" />
    <PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="8.0.0" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.3.2" />
    <PackageReference Include="Velopack" Version="1.2.0" />
    <PackageReference Include="Velopack.Sources" Version="1.2.0" />
  </ItemGroup>

  <ItemGroup>
    <None Update="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <!--
    App icon — embedded as a WPF Resource so both App.xaml and MainWindow.xaml
    can reference it via {pack://...} URIs. app-icon-1024.png is the source
    artwork; app.ico is the multi-resolution Windows icon for Velopack's
    packer "icon" flag (used by the Setup.exe installer). Both ship together.
  -->
  <ItemGroup>
    <Resource Include="assets\app-icon-1024.png" />
  </ItemGroup>

  <ItemGroup>
    <ApplicationDefinition Include="src\App.xaml">
      <Generator>MSBuild:Compile</Generator>
      <SubType>Designer</SubType>
    </ApplicationDefinition>
  </ItemGroup>

  <ItemGroup>
    <Compile Include="src\Program.cs" />
  </ItemGroup>

  <!--
    EnableDefaultApplicationDefinition=false disables WPF's automatic XAML
    inclusion, so every .xaml file (besides App.xaml, listed above as the
    <ApplicationDefinition>) must be listed explicitly as a <Page>. Without
    these, the XAML files compile to nothing, every InitializeComponent()
    call resolves to a missing member, and we get CS0101/CS0117 build errors.
  -->
  <ItemGroup>
    <Page Include="src\MainWindow.xaml">
      <Generator>MSBuild:Compile</Generator>
      <SubType>Designer</SubType>
    </Page>
    <Page Include="src\Views\PrintView.xaml">
      <Generator>MSBuild:Compile</Generator>
      <SubType>Designer</SubType>
    </Page>
    <Page Include="src\Views\SettingsView.xaml">
      <Generator>MSBuild:Compile</Generator>
      <SubType>Designer</SubType>
    </Page>
    <Page Include="src\Views\QueueView.xaml">
      <Generator>MSBuild:Compile</Generator>
      <SubType>Designer</SubType>
    </Page>
    <Page Include="src\Views\HistoryView.xaml">
      <Generator>MSBuild:Compile</Generator>
      <SubType>Designer</SubType>
    </Page>
    <Page Include="src\Views\InventoryView.xaml">
      <Generator>MSBuild:Compile</Generator>
      <SubType>Designer</SubType>
    </Page>
  </ItemGroup>

</Project>