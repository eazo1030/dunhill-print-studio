<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <RootNamespace>Dunhill.PrintStudio</RootNamespace>
    <AssemblyName>DunhillPrintStudio</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>

    <!--
      Disable the auto-generated WPF Main. We provide our own Program.Main that
      runs VelopackApp.Build().Run() FIRST (before any WPF startup) so install /
      uninstall / update hooks can short-circuit the process with the right exit
      code. This is the documented Velopack integration pattern; without it,
      hooks fire AFTER WPF starts and cause mysterious double-launch bugs.
    -->
    <EnableDefaultApplicationDefinition>false</EnableDefaultApplicationDefinition>
    <StartupObject>Dunhill.PrintStudio.Program</StartupObject>

    <!-- Single-file publish settings -->
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>embedded</DebugType>
    <Version>1.2.23</Version>
    <AssemblyVersion>1.2.23.0</AssemblyVersion>
    <FileVersion>1.2.23.0</FileVersion>
    <Product>Dunhill Print Studio</Product>
    <Company>Dunhill Global</Company>
    <Copyright>Copyright © 2026 Dunhill Global</Copyright>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="8.0.0" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="8.0.0" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="8.0.0" />
    <PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="8.0.0" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.3.2" />
    <PackageReference Include="Velopack" Version="1.2.0" />
    <!--
      Note: Velopack.Sources is NOT a real NuGet package. GithubSource,
      SimpleWebSource, etc. live inside the main Velopack.dll under the
      Velopack.Sources namespace. Adding a <PackageReference> for it causes
      NU1101: Unable to find package Velopack.Sources at restore time.
    -->
  </ItemGroup>

  <ItemGroup>
    <None Update="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <!--
    App icon — embedded as a WPF Resource so both App.xaml and MainWindow.xaml
    can reference it via {pack://...} URIs. app-icon-1024.png is the source
    artwork; app.ico is the multi-resolution Windows icon for Velopack's
    packer "icon" flag (used by the Setup.exe installer). Both ship together.
  -->
  <ItemGroup>
    <Resource Include="assets\app-icon-1024.png" />
  </ItemGroup>

  <ItemGroup>
    <ApplicationDefinition Include="src\App.xaml">
      <Generator>MSBuild:Compile</Generator>
      <SubType>Designer</SubType>
    </ApplicationDefinition>
  </ItemGroup>

  <!--
    Program.cs is auto-included by the .NET SDK's default Compile globbing
    (every *.cs under the project directory). DO NOT add an explicit
    <Compile Include="src\Program.cs" /> here — that triggers MSB3105
    "Duplicate 'Compile' items were included." error from the SDK's
    default item rules. Only needed if EnableDefaultCompileItems=false.

    Likewise, all *.xaml files under the project directory are auto-globbed
    by the SDK as <Page> items via EnableDefaultPageItems=true (the default).
    Listing them explicitly here triggers NETSDK1022 "Duplicate 'Page' items".
    The SDK finds MainWindow.xaml, PrintView.xaml, SettingsView.xaml,
    QueueView.xaml, HistoryView.xaml, InventoryView.xaml automatically and
    generates InitializeComponent() correctly for each one.

    App.xaml is the single exception: EnableDefaultApplicationDefinition=false
    (above) disables the SDK's auto <ApplicationDefinition> glob, so App.xaml
    must be listed explicitly as an <ApplicationDefinition> (see above).
  -->

</Project>