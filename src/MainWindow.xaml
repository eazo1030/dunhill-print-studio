<Window x:Class="Dunhill.PrintStudio.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:Dunhill.PrintStudio.Views"
        Title="Dunhill Print Studio"
        Icon="/assets/app-icon-1024.png"
        Height="720" Width="1180"
        MinHeight="540" MinWidth="920"
        WindowStartupLocation="CenterScreen"
        Background="#F4F5F7">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Top header / printer status bar -->
        <Border Grid.Row="0" Background="#1F2937" Padding="20,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" Grid.Column="0" VerticalAlignment="Center">
                    <Image Source="/assets/app-icon-1024.png" Width="24" Height="24"
                           Margin="0,0,10,0" RenderOptions.BitmapScalingMode="HighQuality"/>
                    <Ellipse Width="10" Height="10" Margin="0,0,8,0"
                             x:Name="StatusDot" Fill="#EF4444"/>
                    <TextBlock Text="Dunhill Print Studio" Foreground="White"
                               FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <TextBlock x:Name="PrinterStatusText" Foreground="#D1D5DB"
                               FontSize="13" Margin="20,0,0,0" VerticalAlignment="Center"
                               Text="Disconnected"/>
                </StackPanel>
                <TextBlock Grid.Column="1" x:Name="ClockText" Foreground="#9CA3AF"
                           FontSize="12" VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- Tab area -->
        <TabControl Grid.Row="1" Margin="12"
                    Background="Transparent" BorderThickness="0">
            <TabItem Header="Print">
                <views:PrintView/>
            </TabItem>
            <TabItem Header="Inventory">
                <views:InventoryView/>
            </TabItem>
            <TabItem Header="Queue">
                <views:QueueView/>
            </TabItem>
            <TabItem Header="History">
                <views:HistoryView/>
            </TabItem>
            <TabItem Header="Settings">
                <views:SettingsView/>
            </TabItem>
        </TabControl>

        <!-- Bottom status bar -->
        <Border Grid.Row="2" Background="#E5E7EB" Padding="16,6">
            <TextBlock x:Name="FooterStatus" FontSize="12" Foreground="#6B7280"
                       Text="Ready"/>
        </Border>
    </Grid>
</Window>
