<UserControl x:Class="Dunhill.PrintStudio.Views.HistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Dunhill.PrintStudio.ViewModels"
             d:DataContext="{d:DesignInstance Type=vm:HistoryViewModel}"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" Background="White">
    <Grid Margin="16">
        <TextBlock Text="Print History" Style="{StaticResource PanelHeader}"/>
        <TextBlock Text="All prints done by this PC. Backed by %LOCALAPPDATA%\DunhillPrintStudio\history.json." Foreground="#6B7280" Margin="0,40,0,0"/>
    </Grid>
</UserControl>
