<UserControl x:Class="Dunhill.PrintStudio.Views.DesignerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Dunhill.PrintStudio.ViewModels"
             xmlns:models="clr-namespace:Dunhill.PrintStudio.Models"
             xmlns:views="clr-namespace:Dunhill.PrintStudio.Views"
             d:DataContext="{d:DesignInstance Type=vm:DesignerViewModel}"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" Background="White">

    <!--
      Keyboard shortcuts for the whole Designer tab: Ctrl+Z / Ctrl+Y undo/redo,
      Delete removes the selected element. RoutedCommand bindings inside
      the UserControl.InputBindings so they only fire when this tab is focused.
    -->
    <UserControl.InputBindings>
        <KeyBinding Key="Z" Modifiers="Ctrl" Command="{Binding UndoCommand}"/>
        <KeyBinding Key="Y" Modifiers="Ctrl" Command="{Binding RedoCommand}"/>
        <KeyBinding Key="Delete" Command="{Binding DeleteKeyCommand}"/>
    </UserControl.InputBindings>

    <Grid Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="320"/>
        </Grid.ColumnDefinitions>

        <!-- ========== LEFT: Element library + template list ========== -->
        <Border Padding="14" Margin="0,0,8,0" CornerRadius="8" Background="#FAFAFA">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="Templates" Style="{StaticResource PanelHeader}" Margin="0,0,0,8"/>
                <ComboBox Grid.Row="1"
                          ItemsSource="{Binding Templates}"
                          SelectedItem="{Binding SelectedTemplate}"
                          DisplayMemberPath="Name"
                          Padding="6,4"/>

                <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,8,0,0">
                    <Button Content="New" Padding="10,5"
                            Command="{Binding NewTemplateCommand}"/>
                    <Button Content="Save" Padding="10,5" Margin="6,0,0,0"
                            Style="{StaticResource PrimaryButton}"
                            Command="{Binding SaveCommand}"/>
                    <Button Content="Delete" Padding="10,5" Margin="6,0,0,0"
                            Command="{Binding DeleteCommand}"/>
                    <Button Content="↶ Undo" Padding="10,5" Margin="6,0,0,0"
                            Command="{Binding UndoCommand}"
                            ToolTip="Ctrl+Z — revert the last edit"/>
                    <Button Content="↷ Redo" Padding="10,5" Margin="6,0,0,0"
                            Command="{Binding RedoCommand}"
                            ToolTip="Ctrl+Y — re-apply an undone edit"/>
                </StackPanel>

                <TextBlock Grid.Row="3" Text="Add element" Style="{StaticResource PanelHeader}" Margin="0,18,0,8"/>
                <WrapPanel Grid.Row="4" Orientation="Horizontal">
                    <Button Content="+ Text"    Padding="10,6" Margin="0,0,6,6" Command="{Binding AddTextCommand}"/>
                    <Button Content="+ Barcode" Padding="10,6" Margin="0,0,6,6" Command="{Binding AddBarcodeCommand}"/>
                    <Button Content="+ QR Code" Padding="10,6" Margin="0,0,6,6" Command="{Binding AddQrCodeCommand}"/>
                    <Button Content="+ RFID"    Padding="10,6" Margin="0,0,6,6" Command="{Binding AddRfidCommand}"/>
                    <Button Content="+ Line"    Padding="10,6" Margin="0,0,6,6" Command="{Binding AddLineCommand}"/>
                    <Button Content="+ Box"     Padding="10,6" Margin="0,0,6,6" Command="{Binding AddBoxCommand}"/>
                </WrapPanel>

                <TextBlock Grid.Row="5" Text="Elements" Style="{StaticResource PanelHeader}" Margin="0,16,0,8"/>
                <ListBox Grid.Row="6"
                         ItemsSource="{Binding Elements}"
                         SelectedItem="{Binding SelectedElement}"
                         Height="180">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding DisplaySummary}" FontSize="12"/>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>

        <!-- ========== CENTER: Live preview canvas ========== -->
        <Border Grid.Column="1" Padding="14" Margin="4,0,4,0" CornerRadius="8" Background="#F9FAFB">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="Preview" Style="{StaticResource PanelHeader}" Margin="0,0,0,8"/>

                <!--
                  Preview canvas. Renders every element as a simple shape so the
                  operator can see position and size before committing to print.
                  This is a structural preview (boxes for text, hatched bars for
                  barcodes, squares for QR/RFID) — not a pixel-perfect raster.
                  The actual rendering is done by the printer from the PPLZ shown
                  in the bottom panel.
                -->
                <Border Grid.Row="1" Background="White" BorderBrush="#D1D5DB" BorderThickness="1"
                        Padding="12" CornerRadius="4" ClipToBounds="True">
                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                        <!--
                          Outer Grid hosts mouse-drag handlers (via DesignerCanvasBehavior)
                          and renders the 6 stacked ItemsControls (one per element type).
                          The guides Canvas sits on top, transparent, just for the snap
                          guide lines drawn by the behavior helper.
                        -->
                        <Grid x:Name="LabelCanvas"
                              Width="{Binding SelectedTemplate.WidthDots, FallbackValue=583}"
                              Height="{Binding SelectedTemplate.HeightDots, FallbackValue=160}"
                              Background="White"
                              AllowDrop="False"
                              views:DesignerCanvasBehavior.IsEnabled="True">
                            <Canvas x:Name="GuideCanvas"
                                    Width="{Binding ActualWidth, ElementName=LabelCanvas}"
                                    Height="{Binding ActualHeight, ElementName=LabelCanvas}"
                                    IsHitTestVisible="False"
                                    Background="Transparent"/>
                            <ItemsControl ItemsSource="{Binding Elements}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <Canvas IsItemsHost="True"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemContainerStyle>
                                    <Style TargetType="ContentPresenter">
                                        <Setter Property="Canvas.Left" Value="{Binding X}"/>
                                        <Setter Property="Canvas.Top"  Value="{Binding Y}"/>
                                    </Style>
                                </ItemsControl.ItemContainerStyle>
                                <ItemsControl.Resources>
                                    <!-- Text element preview -->
                                    <DataTemplate DataType="{x:Type models:LabelElement}">
                                        <Border BorderThickness="1" BorderBrush="#3B82F6"
                                                Background="#EFF6FF" Padding="4,2"
                                                CornerRadius="2"
                                                Visibility="{Binding Type, Converter={StaticResource TextTypeVisibility}, ConverterParameter=text}">
                                            <TextBlock Text="{Binding Content}" FontFamily="Consolas"
                                                       FontSize="{Binding FontHeight, Converter={StaticResource DotToFontSize}}"
                                                       Foreground="#1E3A8A"/>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.Resources>
                            </ItemsControl>

                            <!--
                              Barcode / QR / Line / Box / RFID are rendered on top
                              using a second ItemsControl with explicit shapes
                              keyed on the element Type. Keeps the XAML simple.
                            -->
                            <ItemsControl ItemsSource="{Binding Elements}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <Canvas IsItemsHost="True"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemContainerStyle>
                                    <Style TargetType="ContentPresenter">
                                        <Setter Property="Canvas.Left" Value="{Binding X}"/>
                                        <Setter Property="Canvas.Top"  Value="{Binding Y}"/>
                                    </Style>
                                </ItemsControl.ItemContainerStyle>
                                <ItemsControl.Resources>
                                    <!-- Barcode: rendered as a striped pattern so the operator can see width/height -->
                                    <DataTemplate DataType="{x:Type models:LabelElement}">
                                        <Grid Width="{Binding BarcodeHeight, Converter={StaticResource BarcodeWidth}}"
                                              Height="{Binding BarcodeHeight}"
                                              Visibility="{Binding Type, Converter={StaticResource BarcodeTypeVisibility}, ConverterParameter=barcode}">
                                            <Rectangle Fill="#111827"/>
                                            <Rectangle Fill="White" Margin="2,0,0,0" Width="2" HorizontalAlignment="Left"/>
                                            <Rectangle Fill="White" Margin="6,0,0,0" Width="1" HorizontalAlignment="Left"/>
                                            <Rectangle Fill="White" Margin="9,0,0,0" Width="3" HorizontalAlignment="Left"/>
                                            <Rectangle Fill="White" Margin="14,0,0,0" Width="1" HorizontalAlignment="Left"/>
                                            <Rectangle Fill="White" Margin="17,0,0,0" Width="2" HorizontalAlignment="Left"/>
                                            <Rectangle Fill="White" Margin="22,0,0,0" Width="1" HorizontalAlignment="Left"/>
                                            <Rectangle Fill="White" Margin="25,0,0,0" Width="3" HorizontalAlignment="Left"/>
                                            <Rectangle Fill="White" Margin="30,0,0,0" Width="2" HorizontalAlignment="Left"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.Resources>
                            </ItemsControl>

                            <ItemsControl ItemsSource="{Binding Elements}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <Canvas IsItemsHost="True"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemContainerStyle>
                                    <Style TargetType="ContentPresenter">
                                        <Setter Property="Canvas.Left" Value="{Binding X}"/>
                                        <Setter Property="Canvas.Top"  Value="{Binding Y}"/>
                                    </Style>
                                </ItemsControl.ItemContainerStyle>
                                <ItemsControl.Resources>
                                    <!-- QR placeholder -->
                                    <DataTemplate DataType="{x:Type models:LabelElement}">
                                        <Border Width="60" Height="60" BorderBrush="#111827" BorderThickness="3"
                                                Background="White" Margin="0"
                                                Visibility="{Binding Type, Converter={StaticResource QrTypeVisibility}, ConverterParameter=qrcode}">
                                            <TextBlock Text="QR" FontWeight="Bold" FontSize="14"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.Resources>
                            </ItemsControl>

                            <ItemsControl ItemsSource="{Binding Elements}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <Canvas IsItemsHost="True"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemContainerStyle>
                                    <Style TargetType="ContentPresenter">
                                        <Setter Property="Canvas.Left" Value="{Binding X}"/>
                                        <Setter Property="Canvas.Top"  Value="{Binding Y}"/>
                                    </Style>
                                </ItemsControl.ItemContainerStyle>
                                <ItemsControl.Resources>
                                    <!-- RFID chip icon -->
                                    <DataTemplate DataType="{x:Type models:LabelElement}">
                                        <Border Width="40" Height="24" BorderBrush="#059669" BorderThickness="2"
                                                Background="#D1FAE5" CornerRadius="3"
                                                Visibility="{Binding Type, Converter={StaticResource RfidTypeVisibility}, ConverterParameter=rfid}">
                                            <TextBlock Text="RFID" FontWeight="Bold" FontSize="9"
                                                       Foreground="#065F46"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.Resources>
                            </ItemsControl>

                            <ItemsControl ItemsSource="{Binding Elements}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <Canvas IsItemsHost="True"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemContainerStyle>
                                    <Style TargetType="ContentPresenter">
                                        <Setter Property="Canvas.Left" Value="{Binding X}"/>
                                        <Setter Property="Canvas.Top"  Value="{Binding Y}"/>
                                    </Style>
                                </ItemsControl.ItemContainerStyle>
                                <ItemsControl.Resources>
                                    <!-- Line / Box outline -->
                                    <DataTemplate DataType="{x:Type models:LabelElement}">
                                        <Rectangle Stroke="#374151" StrokeThickness="{Binding Thickness}"
                                                   Visibility="{Binding Type, Converter={StaticResource LineTypeVisibility}, ConverterParameter=line}">
                                            <Rectangle.Width>
                                                <Binding Path="Width"/>
                                            </Rectangle.Width>
                                            <Rectangle.Height>2</Rectangle.Height>
                                        </Rectangle>
                                    </DataTemplate>
                                </ItemsControl.Resources>
                            </ItemsControl>

                            <ItemsControl ItemsSource="{Binding Elements}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <Canvas IsItemsHost="True"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemContainerStyle>
                                    <Style TargetType="ContentPresenter">
                                        <Setter Property="Canvas.Left" Value="{Binding X}"/>
                                        <Setter Property="Canvas.Top"  Value="{Binding Y}"/>
                                    </Style>
                                </ItemsControl.ItemContainerStyle>
                                <ItemsControl.Resources>
                                    <DataTemplate DataType="{x:Type models:LabelElement}">
                                        <Rectangle Stroke="#374151" StrokeThickness="{Binding Thickness}"
                                                   Width="{Binding Width}" Height="{Binding Height}"
                                                   Visibility="{Binding Type, Converter={StaticResource BoxTypeVisibility}, ConverterParameter=box}"/>
                                    </DataTemplate>
                                </ItemsControl.Resources>
                            </ItemsControl>
                        </Grid>
                    </ScrollViewer>
                </Border>

                <!-- PPLZ preview strip -->
                <Border Grid.Row="2" Background="White" BorderBrush="#D1D5DB" BorderThickness="1"
                        Padding="10" CornerRadius="4" Margin="0,12,0,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="160"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="Generated PPLZ" FontWeight="SemiBold" FontSize="12"
                                   Foreground="#374151" Margin="0,0,0,6"/>
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <TextBox Text="{Binding LabelPreview, Mode=OneWay}" IsReadOnly="True"
                                     FontFamily="Consolas,Courier New" FontSize="11"
                                     Background="Transparent" BorderThickness="0"
                                     TextWrapping="NoWrap" AcceptsReturn="True"/>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- ========== RIGHT: Properties + sample data ========== -->
        <Border Grid.Column="2" Padding="14" Margin="8,0,0,0" CornerRadius="8" Background="#FAFAFA">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="Properties" Style="{StaticResource PanelHeader}"/>

                    <Border Background="#FFFFFF" Padding="12" CornerRadius="6"
                            BorderBrush="#E5E7EB" BorderThickness="1"
                            Visibility="{Binding SelectedElement, Converter={StaticResource NullToVisibility}}">
                        <StackPanel>
                            <TextBlock Text="Selected element" FontWeight="SemiBold" Margin="0,0,0,8"/>
                            <TextBlock Text="{Binding SelectedElement.Type}" FontSize="12" Foreground="#6B7280" Margin="0,0,0,8"/>

                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="6"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" Padding="6,4"
                                         Text="{Binding SelectedElement.X, UpdateSourceTrigger=PropertyChanged}"/>
                                <TextBox Grid.Column="2" Padding="6,4"
                                         Text="{Binding SelectedElement.Y, UpdateSourceTrigger=PropertyChanged}"/>
                            </Grid>

                            <!-- Type-specific editors -->
                            <StackPanel Visibility="{Binding SelectedElement.Type, Converter={StaticResource TextTypeVisibility}}">
                                <TextBlock Text="Content" FontSize="11" Foreground="#6B7280"/>
                                <TextBox Text="{Binding SelectedElement.Content, UpdateSourceTrigger=PropertyChanged}" Padding="6,4" Margin="0,0,0,6"/>
                                <TextBlock Text="Field binding" FontSize="11" Foreground="#6B7280"/>
                                <ComboBox SelectedItem="{Binding SelectedElement.Field, Mode=TwoWay}" Padding="6,4">
                                    <ComboBoxItem Content="(literal)"/>
                                    <ComboBoxItem Content="Sku"/>
                                    <ComboBoxItem Content="Name"/>
                                    <ComboBoxItem Content="Serial"/>
                                    <ComboBoxItem Content="Epc"/>
                                    <ComboBoxItem Content="Qty"/>
                                </ComboBox>
                                <TextBlock Text="Prefix" FontSize="11" Foreground="#6B7280" Margin="0,6,0,0"/>
                                <TextBox Text="{Binding SelectedElement.Prefix, UpdateSourceTrigger=PropertyChanged}" Padding="6,4" Margin="0,0,0,6"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="6"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Font H" FontSize="11" Foreground="#6B7280"/>
                                        <TextBox Text="{Binding SelectedElement.FontHeight, UpdateSourceTrigger=PropertyChanged}" Padding="6,4"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Font W" FontSize="11" Foreground="#6B7280"/>
                                        <TextBox Text="{Binding SelectedElement.FontWidth, UpdateSourceTrigger=PropertyChanged}" Padding="6,4"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>

                            <StackPanel Visibility="{Binding SelectedElement.Type, Converter={StaticResource BarcodeTypeVisibility}}">
                                <TextBlock Text="Symbology" FontSize="11" Foreground="#6B7280"/>
                                <ComboBox SelectedItem="{Binding SelectedElement.BarcodeType, Mode=TwoWay}" Padding="6,4">
                                    <ComboBoxItem Content="Code128"/>
                                    <ComboBoxItem Content="Code39"/>
                                    <ComboBoxItem Content="EAN13"/>
                                    <ComboBoxItem Content="UPCA"/>
                                </ComboBox>
                                <TextBlock Text="Bar height (dots)" FontSize="11" Foreground="#6B7280" Margin="0,6,0,0"/>
                                <TextBox Text="{Binding SelectedElement.BarcodeHeight, UpdateSourceTrigger=PropertyChanged}" Padding="6,4" Margin="0,0,0,6"/>
                                <TextBlock Text="Field binding" FontSize="11" Foreground="#6B7280"/>
                                <ComboBox SelectedItem="{Binding SelectedElement.Field, Mode=TwoWay}" Padding="6,4">
                                    <ComboBoxItem Content="(literal)"/>
                                    <ComboBoxItem Content="Sku"/>
                                    <ComboBoxItem Content="Epc"/>
                                    <ComboBoxItem Content="Serial"/>
                                </ComboBox>
                            </StackPanel>

                            <StackPanel Visibility="{Binding SelectedElement.Type, Converter={StaticResource QrTypeVisibility}}">
                                <TextBlock Text="Magnification" FontSize="11" Foreground="#6B7280"/>
                                <TextBox Text="{Binding SelectedElement.QrMagnification, UpdateSourceTrigger=PropertyChanged}" Padding="6,4" Margin="0,0,0,6"/>
                                <TextBlock Text="Field binding" FontSize="11" Foreground="#6B7280"/>
                                <ComboBox SelectedItem="{Binding SelectedElement.Field, Mode=TwoWay}" Padding="6,4">
                                    <ComboBoxItem Content="(literal)"/>
                                    <ComboBoxItem Content="QrPayload"/>
                                    <ComboBoxItem Content="Sku"/>
                                    <ComboBoxItem Content="Epc"/>
                                </ComboBox>
                            </StackPanel>

                            <StackPanel Visibility="{Binding SelectedElement.Type, Converter={StaticResource RfidTypeVisibility}}">
                                <TextBlock Text="Bank" FontSize="11" Foreground="#6B7280"/>
                                <ComboBox SelectedItem="{Binding SelectedElement.RfidBank, Mode=TwoWay}" Padding="6,4">
                                    <ComboBoxItem Content="EPC"/>
                                    <ComboBoxItem Content="TID"/>
                                    <ComboBoxItem Content="USER"/>
                                </ComboBox>
                                <TextBlock Text="Words (12 = 96-bit EPC)" FontSize="11" Foreground="#6B7280" Margin="0,6,0,0"/>
                                <TextBox Text="{Binding SelectedElement.RfidWords, UpdateSourceTrigger=PropertyChanged}" Padding="6,4"/>
                            </StackPanel>

                            <StackPanel Visibility="{Binding SelectedElement.Type, Converter={StaticResource LineTypeVisibility}}">
                                <TextBlock Text="Width (dots)" FontSize="11" Foreground="#6B7280"/>
                                <TextBox Text="{Binding SelectedElement.Width, UpdateSourceTrigger=PropertyChanged}" Padding="6,4" Margin="0,0,0,6"/>
                                <TextBlock Text="Thickness" FontSize="11" Foreground="#6B7280"/>
                                <TextBox Text="{Binding SelectedElement.Thickness, UpdateSourceTrigger=PropertyChanged}" Padding="6,4"/>
                            </StackPanel>

                            <StackPanel Visibility="{Binding SelectedElement.Type, Converter={StaticResource BoxTypeVisibility}}">
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="6"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Width" FontSize="11" Foreground="#6B7280"/>
                                        <TextBox Text="{Binding SelectedElement.Width, UpdateSourceTrigger=PropertyChanged}" Padding="6,4"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Height" FontSize="11" Foreground="#6B7280"/>
                                        <TextBox Text="{Binding SelectedElement.Height, UpdateSourceTrigger=PropertyChanged}" Padding="6,4"/>
                                    </StackPanel>
                                </Grid>
                                <TextBlock Text="Thickness" FontSize="11" Foreground="#6B7280"/>
                                <TextBox Text="{Binding SelectedElement.Thickness, UpdateSourceTrigger=PropertyChanged}" Padding="6,4"/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                <Button Content="▲" Padding="8,2" Command="{Binding MoveUpCommand}"/>
                                <Button Content="▼" Padding="8,2" Margin="6,0,0,0" Command="{Binding MoveDownCommand}"/>
                                <Button Content="Remove" Padding="10,2" Margin="6,0,0,0"
                                        Command="{Binding RemoveSelectedCommand}"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="Sample data (preview)" Style="{StaticResource PanelHeader}" Margin="0,16,0,8"/>
                    <StackPanel>
                        <TextBlock Text="SKU" FontSize="11" Foreground="#6B7280"/>
                        <TextBox Text="{Binding SampleSku, UpdateSourceTrigger=PropertyChanged}" Padding="6,4" Margin="0,0,0,6"/>
                        <TextBlock Text="Name" FontSize="11" Foreground="#6B7280"/>
                        <TextBox Text="{Binding SampleName, UpdateSourceTrigger=PropertyChanged}" Padding="6,4" Margin="0,0,0,6"/>
                        <TextBlock Text="Serial" FontSize="11" Foreground="#6B7280"/>
                        <TextBox Text="{Binding SampleSerial, UpdateSourceTrigger=PropertyChanged}" Padding="6,4" Margin="0,0,0,6"/>
                        <TextBlock Text="EPC" FontSize="11" Foreground="#6B7280"/>
                        <TextBox Text="{Binding SampleEpc, UpdateSourceTrigger=PropertyChanged}" Padding="6,4" Margin="0,0,0,6"/>
                        <TextBlock Text="Quantity" FontSize="11" Foreground="#6B7280"/>
                        <TextBox Text="{Binding SampleQty, UpdateSourceTrigger=PropertyChanged}" Padding="6,4"/>
                    </StackPanel>

                    <Border Background="#F3F4F6" Padding="10" Margin="0,16,0,0" CornerRadius="6">
                        <StackPanel>
                            <TextBlock Text="{Binding Status}" FontWeight="SemiBold" FontSize="12"/>
                            <TextBlock Text="{Binding LastError}" Foreground="#DC2626" FontSize="12"
                                       TextWrapping="Wrap" Margin="0,4,0,0"
                                       Visibility="{Binding LastError, Converter={StaticResource StringToVisibility}}"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>