<UserControl x:Class="Dunhill.PrintStudio.Views.DesignerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Dunhill.PrintStudio.ViewModels"
             d:DataContext="{d:DesignInstance Type=vm:DesignerViewModel}"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" Background="White">

    <!--
      Locked "Fabric / Yardage / PO + Date Printed" label tab.

      v1.2.5 — drag-and-drop removed. The user wanted one fixed layout
      (Fabric Name / Yardage / PO + Date Printed at the bottom), so this
      view is now a fill-in-form + read-only preview + PPLZ readout.
      There is nothing to drag, nothing to add, nothing to break.

      Label is 73×20mm RFID inlay at 203 dpi → 583×160 dots. The preview
      below uses exactly that aspect ratio so what you see matches what
      arrives at the printer.
    -->
    <Grid Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="320"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ========== LEFT: Fill-in form ========== -->
        <Border Padding="14" Margin="0,0,8,0" CornerRadius="8" Background="#FAFAFA">
            <StackPanel>
                <TextBlock Text="Fabric Yardage Tag" Style="{StaticResource PanelHeader}"/>
                <TextBlock Text="Fixed layout — fill in the fields and watch the preview update."
                           FontSize="12" Foreground="#6B7280" Margin="0,0,0,12"
                           TextWrapping="Wrap"/>

                <TextBlock Text="Fabric Name" Style="{StaticResource FieldLabel}" Margin="0,0,0,4"/>
                <TextBox Text="{Binding FabricName, UpdateSourceTrigger=PropertyChanged}" Padding="6,4"/>

                <TextBlock Text="Yardage" Style="{StaticResource FieldLabel}" Margin="0,12,0,4"/>
                <TextBox Text="{Binding Yardage, UpdateSourceTrigger=PropertyChanged}" Padding="6,4"/>

                <TextBlock Text="PO (Purchase Order)" Style="{StaticResource FieldLabel}" Margin="0,12,0,4"/>
                <TextBox Text="{Binding Po, UpdateSourceTrigger=PropertyChanged}" Padding="6,4"/>

                <TextBlock Text="Date Printed" Style="{StaticResource FieldLabel}" Margin="0,12,0,4"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0"
                             Text="{Binding DatePrinted, UpdateSourceTrigger=PropertyChanged}"
                             Padding="6,4"
                             ToolTip="Auto-filled with today's date. Edit to override."/>
                    <Button Grid.Column="1" Content="Today" Padding="10,4" Margin="6,0,0,0"
                            Command="{Binding UseTodayCommand}"
                            ToolTip="Reset Date Printed to today"/>
                </Grid>

                <Border Background="#F3F4F6" Padding="10" Margin="0,20,0,0" CornerRadius="6">
                    <StackPanel>
                        <TextBlock Text="{Binding Status}" FontWeight="SemiBold" FontSize="12"/>
                        <TextBlock Text="{Binding LastError}" Foreground="#DC2626" FontSize="12"
                                   TextWrapping="Wrap" Margin="0,4,0,0"
                                   Visibility="{Binding LastError, Converter={StaticResource StringToVisibility}}"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

        <!-- ========== RIGHT: Live preview + PPLZ readout ========== -->
        <Border Grid.Column="1" Padding="14" Margin="8,0,0,0" CornerRadius="8" Background="#F9FAFB">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="Label Preview (73×20mm RFID inlay, 583×160 dots @ 203dpi)"
                           Style="{StaticResource PanelHeader}" Margin="0,0,0,8"/>

                <!--
                  Visual preview — uses a real Grid sized to the label's
                  actual dots. A Border with a contrasting background gives
                  the "label paper" outline. The four TextBlocks inside are
                  placed at coordinates that match the PPLZ builder so what
                  you see is what the printer draws.
                -->
                <Border Grid.Row="1" Background="#F9FAFB" Padding="20" CornerRadius="4">
                    <Grid HorizontalAlignment="Center" VerticalAlignment="Top">
                        <!-- Scale up from 583 wide so the preview is readable: ×1.4 → 816 -->
                        <Border Width="816" Height="224"
                                Background="White" BorderBrush="#D1D5DB" BorderThickness="1"
                                CornerRadius="2">
                            <Grid Margin="14">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="36"/>     <!-- Fabric Name -->
                                    <RowDefinition Height="76"/>     <!-- Yardage -->
                                    <RowDefinition Height="2"/>      <!-- Divider -->
                                    <RowDefinition Height="38"/>     <!-- PO -->
                                    <RowDefinition Height="*"/>      <!-- Date Printed (small) -->
                                </Grid.RowDefinitions>

                                <!-- Fabric Name — medium, dark blue -->
                                <TextBlock Grid.Row="0"
                                           Text="{Binding FabricName, FallbackValue='Fabric Name'}"
                                           FontFamily="Arial" FontWeight="SemiBold"
                                           FontSize="22" Foreground="#1E3A8A"
                                           VerticalAlignment="Center"/>

                                <!-- Yardage — large, the headline -->
                                <TextBlock Grid.Row="1"
                                           Text="{Binding Yardage, FallbackValue='12.5 yds'}"
                                           FontFamily="Arial" FontWeight="Bold"
                                           FontSize="40" Foreground="#111827"
                                           VerticalAlignment="Center"/>

                                <!-- Divider -->
                                <Rectangle Grid.Row="2" Height="2" Fill="#9CA3AF"/>

                                <!-- PO -->
                                <TextBlock Grid.Row="3"
                                           Text="{Binding Po, FallbackValue='PO-'}"
                                           FontFamily="Arial"
                                           FontSize="18" Foreground="#374151"
                                           VerticalAlignment="Center"/>

                                <!-- Date Printed — small, grey, bottom -->
                                <TextBlock Grid.Row="4"
                                           Text="{Binding DatePrintedFooter, FallbackValue='Date Printed: 00/00/0000'}"
                                           FontFamily="Arial" FontSize="11"
                                           Foreground="#9CA3AF"
                                           VerticalAlignment="Bottom"
                                           HorizontalAlignment="Right"
                                           Margin="0,0,4,2"/>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>

                <!-- Live PPLZ — read-only, copy-paste friendly -->
                <Border Grid.Row="2" Background="White" BorderBrush="#D1D5DB" BorderThickness="1"
                        Padding="10" CornerRadius="4" Margin="0,12,0,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="Generated PPLZ" FontWeight="SemiBold"
                                   FontSize="12" Foreground="#374151" Margin="0,0,0,6"/>
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Auto">
                            <TextBox Text="{Binding LabelPreview, Mode=OneWay}" IsReadOnly="True"
                                     FontFamily="Consolas,Courier New" FontSize="11"
                                     Background="Transparent" BorderThickness="0"
                                     TextWrapping="NoWrap" AcceptsReturn="True"/>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
