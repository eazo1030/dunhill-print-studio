<UserControl x:Class="Dunhill.PrintStudio.Views.PrintView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Dunhill.PrintStudio.ViewModels"
             d:DataContext="{d:DesignInstance Type=vm:PrintViewModel}"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             Background="White">

    <Grid Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- LEFT: form -->
        <Border Padding="20" Margin="0,0,8,0" CornerRadius="8" Background="#FAFAFA">
            <StackPanel>
                <TextBlock Text="Print Label" Style="{StaticResource PanelHeader}"/>

                <TextBlock Text="SKU" Style="{StaticResource FieldLabel}"/>
                <TextBox Text="{Binding Sku, UpdateSourceTrigger=PropertyChanged}" Padding="8,6"/>

                <TextBlock Text="Item name" Style="{StaticResource FieldLabel}"/>
                <TextBox Text="{Binding ItemName, UpdateSourceTrigger=PropertyChanged}" Padding="8,6"/>

                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Quantity" Style="{StaticResource FieldLabel}"/>
                        <TextBox Text="{Binding Quantity, UpdateSourceTrigger=PropertyChanged}" Padding="8,6"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Serial (optional)" Style="{StaticResource FieldLabel}"/>
                        <TextBox Text="{Binding Serial, UpdateSourceTrigger=PropertyChanged}" Padding="8,6"/>
                    </StackPanel>
                </Grid>

                <TextBlock Text="EPC (RFID, auto-generated if blank)" Style="{StaticResource FieldLabel}"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0" Text="{Binding Epc, UpdateSourceTrigger=PropertyChanged}" Padding="8,6"/>
                    <CheckBox Grid.Column="1" Content="Encode RFID" IsChecked="{Binding EncodeRfid}"
                              VerticalAlignment="Center" Margin="10,0,0,0"/>
                </Grid>

                <StackPanel Orientation="Horizontal" Margin="0,20,0,0">
                    <Button Content="Print Label" Style="{StaticResource PrimaryButton}"
                            Command="{Binding PrintCommand}" IsEnabled="{Binding IsBusy, Converter={StaticResource Invert}}"/>
                    <Button Content="Clear" Margin="10,0,0,0" Padding="16,10"
                            Command="{Binding ClearFormCommand}"/>
                </StackPanel>

                <Border Background="#F3F4F6" Padding="12" Margin="0,20,0,0" CornerRadius="6">
                    <StackPanel>
                        <TextBlock Text="{Binding Status}" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding LastError}" Foreground="#DC2626"
                                   TextWrapping="Wrap" Margin="0,4,0,0"
                                   Visibility="{Binding LastError, Converter={StaticResource StringToVisibility}}"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

        <!-- RIGHT: preview + recent -->
        <Border Grid.Column="1" Padding="20" Margin="8,0,0,0" CornerRadius="8" Background="#FAFAFA">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="Live PPLZ Preview" Style="{StaticResource PanelHeader}"/>

                <Border Grid.Row="1" Background="White" BorderBrush="#D1D5DB" BorderThickness="1"
                        Padding="12" CornerRadius="4">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <TextBox Text="{Binding LabelPreview, Mode=OneWay}" IsReadOnly="True"
                                 FontFamily="Consolas,Courier New" FontSize="11"
                                 Background="Transparent" BorderThickness="0"
                                 TextWrapping="NoWrap" AcceptsReturn="True"/>
                    </ScrollViewer>
                </Border>

                <StackPanel Grid.Row="2" Margin="0,16,0,0">
                    <TextBlock Text="Recent prints" FontSize="13" Foreground="#4B5563" Margin="0,0,0,6"/>
                    <ItemsControl ItemsSource="{Binding RecentJobs}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" FontFamily="Consolas" FontSize="12"
                                           Foreground="#374151"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
