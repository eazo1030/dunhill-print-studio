<UserControl x:Class="Dunhill.PrintStudio.Views.PrintView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Dunhill.PrintStudio.ViewModels"
             d:DataContext="{d:DesignInstance Type=vm:PrintViewModel}"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             Background="White">

    <Grid Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- LEFT: Form -->
        <Border Padding="20" Margin="0,0,8,0" CornerRadius="8" Background="#FAFAFA">
            <StackPanel>
                <TextBlock Text="Print Label" Style="{StaticResource PanelHeader}"/>
                <TextBlock Text="Fill in the fields and hit Print. Live PPLZ preview updates on the right."
                           FontSize="12" Foreground="#6B7280" Margin="0,0,0,12"/>

                <TextBlock Text="SKU" Style="{StaticResource FieldLabel}" Margin="0,0,0,4"/>
                <TextBox Text="{Binding Sku, UpdateSourceTrigger=PropertyChanged}"/>

                <TextBlock Text="Item name" Style="{StaticResource FieldLabel}" Margin="0,12,0,4"/>
                <TextBox Text="{Binding ItemName, UpdateSourceTrigger=PropertyChanged}"/>

                <Grid Margin="0,4,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Quantity" Style="{StaticResource FieldLabel}" Margin="0,12,0,4"/>
                        <TextBox Text="{Binding Quantity, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Serial (optional)" Style="{StaticResource FieldLabel}" Margin="0,12,0,4"/>
                        <TextBox Text="{Binding Serial, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                </Grid>

                <TextBlock Text="EPC (RFID, auto-generated if blank)" Style="{StaticResource FieldLabel}" Margin="0,4,0,4"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0" Text="{Binding Epc, UpdateSourceTrigger=PropertyChanged}"/>
                    <CheckBox Grid.Column="1" Content="Encode RFID" IsChecked="{Binding EncodeRfid}"
                              VerticalAlignment="Center" Margin="12,0,0,0" FontSize="13"/>
                </Grid>

                <!-- v1.2.8 — fabric-yardage layout fields. These are what
                     actually print on the label media. -->
                <TextBlock Text="Fabric Name" Style="{StaticResource FieldLabel}" Margin="0,16,0,4"/>
                <TextBox Text="{Binding FabricName, UpdateSourceTrigger=PropertyChanged}"/>

                <TextBlock Text="Yardage" Style="{StaticResource FieldLabel}" Margin="0,12,0,4"/>
                <TextBox Text="{Binding Yardage, UpdateSourceTrigger=PropertyChanged}"/>

                <TextBlock Text="PO (Purchase Order)" Style="{StaticResource FieldLabel}" Margin="0,12,0,4"/>
                <TextBox Text="{Binding Po, UpdateSourceTrigger=PropertyChanged}"/>

                <TextBlock Text="Date Printed" Style="{StaticResource FieldLabel}" Margin="0,12,0,4"/>
                <TextBox Text="{Binding DatePrinted, UpdateSourceTrigger=PropertyChanged}"/>

                <StackPanel Orientation="Horizontal" Margin="0,20,0,0">
                    <Button Content="Print Label" Style="{StaticResource PrimaryButton}"
                            Command="{Binding PrintCommand}" IsEnabled="{Binding IsBusy, Converter={StaticResource Invert}}"/>
                    <Button Content="Clear" Style="{StaticResource SecondaryButton}" Margin="10,0,0,0"
                            Command="{Binding ClearFormCommand}"/>
                </StackPanel>

                <Border Background="#F3F4F6" Padding="14" Margin="0,20,0,0" CornerRadius="8">
                    <StackPanel>
                        <TextBlock Text="{Binding Status}" FontWeight="SemiBold" FontSize="13"/>
                        <TextBlock Text="{Binding LastError}" Foreground="#DC2626"
                                   TextWrapping="Wrap" Margin="0,6,0,0" FontSize="12"
                                   Visibility="{Binding LastError, Converter={StaticResource StringToVisibility}}"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

        <!-- RIGHT: Recent jobs (PPLZ preview removed — was unused by the operator) -->
        <Border Grid.Column="1" Padding="20" Margin="8,0,0,0" CornerRadius="8" Background="#FAFAFA">
            <StackPanel>
                <TextBlock Text="Recent prints" FontWeight="SemiBold" FontSize="13"
                           Foreground="#374151" Margin="0,0,0,8"/>
                <ItemsControl ItemsSource="{Binding RecentJobs}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" FontFamily="Consolas" FontSize="12"
                                       Foreground="#374151" Margin="0,2,0,2"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>