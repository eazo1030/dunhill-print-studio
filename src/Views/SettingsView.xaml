<UserControl x:Class="Dunhill.PrintStudio.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Dunhill.PrintStudio.ViewModels"
             d:DataContext="{d:DesignInstance Type=vm:SettingsViewModel}"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" Background="White">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Printer &amp; Cloud Settings" Style="{StaticResource PanelHeader}"/>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- LEFT: Printer connection -->
            <Border Padding="20" Margin="0,0,8,0" CornerRadius="8" Background="#FAFAFA">
                <StackPanel>

                    <TextBlock Text="USB / Spooler printer (Windows print queue)" Style="{StaticResource FieldLabel}"/>
                    <TextBlock FontSize="11" Foreground="#6B7280" TextWrapping="Wrap" Margin="0,2,0,8"
                               Text="The Postek Seagull driver creates a Windows print queue when installed. BarTender talks to the printer through that queue. Same path here."/>

                    <DockPanel LastChildFill="False">
                        <Button DockPanel.Dock="Left" Content="Refresh"
                                Style="{StaticResource SecondaryButton}"
                                Command="{Binding RefreshSpoolerCommand}"/>
                        <Button DockPanel.Dock="Right" Content="Connect" Padding="12,6" Margin="8,0,0,0"
                                Command="{Binding ConnectSpoolerCommand}"/>
                    </DockPanel>
                    <ListBox ItemsSource="{Binding SpoolerPrinters}"
                             SelectedItem="{Binding SelectedSpooler}"
                             Height="120" Margin="0,8,0,0" Padding="6">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                    <TextBlock FontSize="11" Foreground="#6B7280">
                                        <Run Text="Driver: "/>
                                        <Run Text="{Binding DriverName}"/>
                                        <Run Text="  Port: "/>
                                        <Run Text="{Binding PortName}"/>
                                    </TextBlock>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <TextBlock Text="Browser Print Server (Postek local HTTP bridge)" Style="{StaticResource FieldLabel}" Margin="0,24,0,4"/>
                    <TextBlock FontSize="11" Foreground="#6B7280" TextWrapping="Wrap" Margin="0,2,0,8"
                               Text="Postek's official HTTP bridge runs on the operator's PC at 127.0.0.1:888. Same wire shape as the demo HTML. Works for cloud → operator's-PC scenarios."/>

                    <TextBlock Text="Endpoint URL" Style="{StaticResource FieldLabel}" Margin="0,4,0,4"/>
                    <DockPanel LastChildFill="True">
                        <TextBox Text="{Binding BrowserPrintEndpoint, UpdateSourceTrigger=PropertyChanged}"
                                 Padding="8,6"/>
                    </DockPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <Button Content="Connect Browser Print" Style="{StaticResource PrimaryButton}"
                                Command="{Binding ConnectBrowserPrintCommand}"/>
                        <Button Content="Probe" Margin="10,0,0,0" Padding="16,10"
                                Command="{Binding TestBrowserPrintCommand}"/>
                    </StackPanel>

                    <TextBlock Text="Network printer (TCP :9100)" Style="{StaticResource FieldLabel}" Margin="0,24,0,4"/>

                    <TextBlock Text="Host or IP" Style="{StaticResource FieldLabel}" Margin="0,12,0,4"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="80"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" Text="{Binding TcpHost, UpdateSourceTrigger=PropertyChanged}"
                                 Padding="8,6"/>
                        <TextBox Grid.Column="1" Text="{Binding TcpPort, UpdateSourceTrigger=PropertyChanged}"
                                 Padding="8,6" Margin="6,0,0,0"/>
                    </Grid>

                    <StackPanel Orientation="Horizontal" Margin="0,20,0,0">
                        <Button Content="Connect TCP" Style="{StaticResource PrimaryButton}"
                                Command="{Binding ConnectTcpCommand}"/>
                        <Button Content="Disconnect" Margin="10,0,0,0" Padding="16,10"
                                Command="{Binding DisconnectCommand}"/>
                        <Button Content="Print test label" Margin="10,0,0,0" Padding="16,10"
                                Command="{Binding PrintTestLabelCommand}"/>
                    </StackPanel>

                    <Border Background="#F3F4F6" Padding="12" Margin="0,16,0,0" CornerRadius="6">
                        <StackPanel>
                            <TextBlock Text="{Binding Status}" FontWeight="SemiBold"/>
                            <TextBlock Foreground="#6B7280" FontSize="12" Margin="0,4,0,0">
                                <Run Text="Mode: "/>
                                <Run Text="{Binding ConnectionMode, Mode=OneWay}"/>
                            </TextBlock>
                            <TextBlock Text="{Binding ConnectionDetail}" Foreground="#6B7280" FontSize="12"
                                       Visibility="{Binding ConnectionDetail, Converter={StaticResource StringToVisibility}}"/>
                            <TextBlock Text="{Binding LastError}" Foreground="#DC2626"
                                       TextWrapping="Wrap" Margin="0,4,0,0"
                                       Visibility="{Binding LastError, Converter={StaticResource StringToVisibility}}"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <!-- RIGHT: Cloud settings + Updates -->
            <Border Grid.Column="1" Padding="20" Margin="8,0,0,0" CornerRadius="8" Background="#FAFAFA">
                <StackPanel>
                    <TextBlock Text="Cloud sync" Style="{StaticResource PanelHeader}" Margin="0"/>

                    <TextBlock Text="Vercel API URL" Style="{StaticResource FieldLabel}"/>
                    <TextBox Text="{Binding CloudUrl, UpdateSourceTrigger=PropertyChanged}" Padding="8,6"/>

                    <TextBlock Text="Auth token" Style="{StaticResource FieldLabel}"/>
                    <PasswordBox x:Name="AuthBox" Padding="8,6"
                                 PasswordChanged="AuthBox_PasswordChanged"/>

                    <TextBlock TextWrapping="Wrap" Foreground="#6B7280" FontSize="12" Margin="0,16,0,0">
                        The auth token lets this PC pull print jobs from your website
                        and push completion events back. Get it from
                        <Run FontWeight="SemiBold">Settings -&gt; API tokens</Run>
                        on dunhill-inventory-service.vercel.app.
                    </TextBlock>

                    <Border Background="#FEF3C7" Padding="12" Margin="0,16,0,0" CornerRadius="6">
                        <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="#92400E">
                            <Run FontWeight="SemiBold">USB tip:</Run>
                            If no Postek printer appears in the list above, install
                            the printer via <Run FontWeight="SemiBold">Windows Settings
                            -&gt; Printers &amp; scanners -&gt; Add device</Run>. Use the
                            Seagull driver from BarTender UL for Postek (it shipped
                            with the printer CD) or download it from
                            <Run FontWeight="SemiBold">postekchina.com</Run>.
                        </TextBlock>
                    </Border>

                    <!--
                      Updates — self-updater panel. Two visible states driven
                      by UpdateAvailable:
                        (a) idle/up-to-date: shows "Check for updates" button
                        (b) update found: shows "Download &amp; restart" button
                      Both show CurrentVersion + the latest UpdateStatusMessage.
                    -->
                    <Border Background="#EEF2FF" Padding="12" Margin="0,16,0,0" CornerRadius="6">
                        <StackPanel>
                            <TextBlock Text="Updates" FontWeight="SemiBold" Margin="0,0,0,4"/>
                            <TextBlock FontSize="12" Foreground="#6B7280" Margin="0,0,0,8">
                                <Run Text="Current version: v"/>
                                <Run Text="{Binding CurrentVersion, Mode=OneWay}"/>
                            </TextBlock>
                            <TextBlock Text="{Binding UpdateStatusMessage}" FontSize="12"
                                       TextWrapping="Wrap" Margin="0,0,0,8"
                                       Visibility="{Binding UpdateStatusMessage, Converter={StaticResource StringToVisibility}}"/>

                            <!-- Idle state: no update found yet -->
                            <Button Content="Check for updates" Padding="14,8"
                                    Command="{Binding CheckForUpdateCommand}"
                                    Visibility="{Binding UpdateAvailable, Converter={StaticResource Invert}, FallbackValue=Visible}"/>

                            <!-- Update-found state -->
                            <StackPanel Orientation="Horizontal"
                                        Visibility="{Binding UpdateAvailable, FallbackValue=Collapsed}">
                                <TextBlock VerticalAlignment="Center" FontSize="12" Margin="0,0,10,0">
                                    <Run Text="v"/>
                                    <Run Text="{Binding AvailableVersion, Mode=OneWay}"/>
                                    <Run Text=" is available."/>
                                </TextBlock>
                                <Button Content="Download &amp; restart" Style="{StaticResource PrimaryButton}"
                                        Padding="14,8"
                                        Command="{Binding DownloadAndRestartCommand}"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>